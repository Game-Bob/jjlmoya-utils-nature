{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "gamebob-utilities-nature",
    "main": "src/worker.ts",
    "compatibility_date": "2026-07-22",
    "workers_dev": false,
    "preview_urls": true,
    "routes": [
        {
            "pattern": "www.jjlmoya.es/utilidades/categorias/naturaleza*",
            "zone_name": "jjlmoya.es"
        },
        {
            "pattern": "www.jjlmoya.es/utilidades/calculadora-volumen-compostador-proporcion-marrones-verdes*",
            "zone_name": "jjlmoya.es"
        },
        {
